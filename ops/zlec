#!/usr/bin/env bash
# zlec — jedna deterministyczna kolejka delegacji dla całego zespołu. [ENZO 2026-07-21]
# Użycie: zlec <polly|dexter|enzo|charlie> <projekt|-> "<zadanie>" [limit_minut]
set -euo pipefail

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
  echo 'użycie: zlec <polly|dexter|enzo|charlie> <projekt|-> "<zadanie>" [limit_minut]' >&2
  exit 2
fi

exec /usr/bin/python3 /path/to/YOUR_WORKSPACE/ops/team-task-runner.py enqueue \
  --agent "$1" --project "$2" --task "$3" --limit "${4:-30}"
